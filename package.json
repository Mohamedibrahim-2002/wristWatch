{
  "name": "wristwatch-swebok-app",
  "version": "1.0.0",
  "description": "Wrist Watch Web Application adhering to IEEE SWEBOK v4 standards: secure e-commerce, interactive luxury watch configurator, and DevSecOps controls",
  "type": "module",
  "scripts": {
    "dev:php": "php -S localhost:5000 index.php",
    "dev:client": "vite",
    "dev": "vite",
    "build:client": "vite build",
    "build": "vite build",
    "start": "php -S localhost:5000 index.php",
    "test:php": "php tests/TestRunner.php",
    "test": "php tests/TestRunner.php",
    "lint": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high",
    "sbom:generate": "node scripts/generate-sbom.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
